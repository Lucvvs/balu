# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Dejar vacío para usar SQLite en desarrollo)
# Para producción en Render, se configurará automáticamente desde DATABASE_URL
DATABASE_URL=

# Opcional: Email Configuration (si usas email)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
